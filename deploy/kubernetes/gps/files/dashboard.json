{
  "uid": "gps-overview",
  "title": "GPS services",
  "tags": ["gps"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-3h", "to": "now"},
  "panels": [
    {
      "type": "timeseries",
      "title": "Requests per second",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application) (rate(http_server_requests_seconds_count{namespace=\"gps\"}[5m]))",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Server errors (5xx share)",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application) (rate(http_server_requests_seconds_count{namespace=\"gps\", status=~\"5..\"}[5m])) / sum by (application) (rate(http_server_requests_seconds_count{namespace=\"gps\"}[5m]))",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency, 95th percentile",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (application, le) (rate(http_server_requests_seconds_bucket{namespace=\"gps\"}[5m])))",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Kong: requests by route and status",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route, code) (rate(kong_http_requests_total{namespace=\"gps\"}[5m]))",
          "legendFormat": "{{route}} {{code}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Location messages waiting in RabbitMQ",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rabbitmq_queue_messages_ready{namespace=\"gps\"})",
          "legendFormat": "ready"
        },
        {
          "refId": "B",
          "expr": "sum(rabbitmq_queue_messages_unacked{namespace=\"gps\"})",
          "legendFormat": "being processed"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM heap in use",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (jvm_memory_used_bytes{namespace=\"gps\", area=\"heap\"})",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Database connections in use",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application) (hikaricp_connections_active{namespace=\"gps\"})",
          "legendFormat": "{{application}}"
        }
      ]
    }
  ]
}
