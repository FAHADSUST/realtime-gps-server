# Managed by Ansible (role: ops_ui). Contains a Secret: applied with output suppressed.
{% for namespace in ops_ui_secret_only_namespaces %}
---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ namespace }}
{% endfor %}
{% for namespace in (ops_ui_sites | map(attribute='namespace') | list + ops_ui_secret_only_namespaces) | unique %}
---
apiVersion: v1
kind: Secret
metadata:
  name: ops-ui-basic-auth
  namespace: {{ namespace }}
type: Opaque
data:
  auth: {{ ops_ui_htpasswd | b64encode }}
{% endfor %}
{% for site in ops_ui_sites %}
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ site.name }}
  namespace: {{ site.namespace }}
  annotations:
    cert-manager.io/cluster-issuer: {{ cluster_issuer }}
    nginx.ingress.kubernetes.io/auth-type: basic
    nginx.ingress.kubernetes.io/auth-secret: ops-ui-basic-auth
    nginx.ingress.kubernetes.io/auth-realm: "{{ cluster_name }} operators"
{% for key, value in (site.annotations | default({})).items() %}
    {{ key }}: "{{ value }}"
{% endfor %}
spec:
  ingressClassName: nginx
  tls:
    - hosts:
        - {{ site.name }}.{{ cluster_domain }}
      secretName: {{ site.name }}-tls
  rules:
    - host: {{ site.name }}.{{ cluster_domain }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ site.service }}
                port:
                  number: {{ site.port }}
{% endfor %}
