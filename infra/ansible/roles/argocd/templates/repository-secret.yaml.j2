# Managed by Ansible (role: argocd). Read access to a private GitOps repository.
apiVersion: v1
kind: Secret
metadata:
  name: gitops-repository
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: repository
type: Opaque
data:
  type: {{ 'git' | b64encode }}
  url: {{ gitops_repo_url | b64encode }}
  username: {{ vault_gitops_repo_username | b64encode }}
  password: {{ vault_gitops_repo_password | b64encode }}
