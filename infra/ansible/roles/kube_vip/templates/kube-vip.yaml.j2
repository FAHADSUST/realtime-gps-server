# Managed by Ansible (role: kube_vip); local edits are overwritten.
# Holds the Kubernetes API virtual IP {{ kubernetes_api_vip }}: the control planes elect a leader,
# and the leader answers ARP for the VIP. See docs/on-prem/03-kubernetes.md.
apiVersion: v1
kind: Pod
metadata:
  name: kube-vip
  namespace: kube-system
spec:
  containers:
    - name: kube-vip
      image: {{ kube_vip_image }}
      imagePullPolicy: IfNotPresent
      args: [manager]
      env:
        - name: address
          value: "{{ kubernetes_api_vip }}"
        - name: port
          value: "{{ kubernetes_api_port }}"
        - name: vip_interface
          value: "{{ kube_vip_interface }}"
        - name: vip_arp
          value: "true"
        - name: vip_nodename
          valueFrom:
            fieldRef:
              fieldPath: spec.nodeName
        # Control-plane VIP only; Services get their addresses from MetalLB.
        - name: cp_enable
          value: "true"
        - name: cp_namespace
          value: kube-system
        - name: vip_leaderelection
          value: "true"
        - name: vip_leasename
          value: plndr-cp-lock
        - name: vip_leaseduration
          value: "{{ kube_vip_lease_duration }}"
        - name: vip_renewdeadline
          value: "{{ kube_vip_renew_deadline }}"
        - name: vip_retryperiod
          value: "{{ kube_vip_retry_period }}"
        - name: prometheus_server
          value: ":2112"
      securityContext:
        capabilities:
          add: [NET_ADMIN, NET_RAW]
          drop: [ALL]
      volumeMounts:
        - name: kubeconfig
          mountPath: /etc/kubernetes/admin.conf
          readOnly: true
  # kube-vip talks to the API server on this node through "kubernetes", not through the VIP it is
  # about to provide.
  hostAliases:
    - ip: 127.0.0.1
      hostnames: [kubernetes]
  hostNetwork: true
  priorityClassName: system-node-critical
  volumes:
    - name: kubeconfig
      hostPath:
        path: {{ kube_vip_kubeconfig }}
        # File, not the default: a missing kubeconfig must fail the pod, not be created as a directory.
        type: File
