# Helm values for Ingress-NGINX {{ ingress_nginx_chart_version }} (role: ingress_nginx).
controller:
  # One controller per worker. With externalTrafficPolicy Local, MetalLB can announce the ingress
  # address from any worker, and backends see the real client address.
  kind: DaemonSet

  service:
    type: LoadBalancer
    externalTrafficPolicy: Local
    annotations:
      metallb.io/address-pool: ingress
      metallb.io/loadBalancerIPs: "{{ ingress_lb_ip }}"

  # The default class: an Ingress without ingressClassName is served here too.
  ingressClassResource:
    name: nginx
    default: true

  # Snippet annotations would let any Ingress inject raw NGINX configuration. They stay off.
  allowSnippetAnnotations: false

  # The wildcard certificate cert-manager issues for *.{{ cluster_domain }}. Until it exists the
  # controller serves its built-in self-signed one, and picks this up once it appears.
  extraArgs:
    default-ssl-certificate: ingress-nginx/default-tls

  config:
    # Hide the NGINX version in responses and error pages.
    server-tokens: "false"
    # Access logs as JSON, so the log pipeline can parse every field without a regex.
    log-format-escape-json: "true"
    log-format-upstream: >-
      {"time": "$time_iso8601", "request_id": "$req_id", "remote_addr": "$remote_addr",
      "method": "$request_method", "host": "$host", "uri": "$request_uri", "status": $status,
      "bytes_sent": $bytes_sent, "request_time": $request_time, "upstream_addr": "$upstream_addr",
      "upstream_status": "$upstream_status", "upstream_response_time": "$upstream_response_time",
      "user_agent": "$http_user_agent", "namespace": "$namespace", "ingress": "$ingress_name",
      "service": "$service_name"}

  metrics:
    enabled: true
    serviceMonitor:
      enabled: true
