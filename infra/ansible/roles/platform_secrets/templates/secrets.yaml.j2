# Managed by Ansible (role: platform_secrets). Contains Secrets: applied with output suppressed.
{% for namespace in platform_secrets_list | map(attribute='namespace') | unique %}
---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ namespace }}
{% endfor %}
{% for secret in platform_secrets_list %}
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ secret.name }}
  namespace: {{ secret.namespace }}
type: {{ secret.type | default('Opaque') }}
data:
{% for key, value in secret.data.items() %}
{# Ansible may hand back a JSON value (such as .dockerconfigjson) as a dict: store it as JSON. #}
  {{ key }}: {{ (value if value is string else value | to_json) | b64encode }}
{% endfor %}
{% endfor %}
