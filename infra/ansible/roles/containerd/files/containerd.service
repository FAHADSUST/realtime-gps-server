# Managed by Ansible (role: containerd). The unit containerd publishes for its release binaries.

[Unit]
Description=containerd container runtime
Documentation=https://containerd.io
After=network.target dbus.service

[Service]
ExecStartPre=-/sbin/modprobe overlay
ExecStart=/usr/local/bin/containerd

Type=notify
Delegate=yes
# Stop only the daemon; the shims keep the containers running across restarts and upgrades.
KillMode=process
Restart=always
RestartSec=5

# Accounting happens in cgroups; process and core limits here only add overhead.
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
OOMScoreAdjust=-999

[Install]
WantedBy=multi-user.target
