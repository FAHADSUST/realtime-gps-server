# The hand-off to Ansible: every node with its address, plus the cluster addresses Terraform
# validated. Built from module outputs, so it is only written once the VMs exist.

locals {
  inventory_hosts = {
    for role in ["control_plane", "worker"] : role => {
      for name, node in module.node : name => {
        ansible_host = node.ipv4_address
        node_ip      = node.ipv4_address
      } if node.role == role
    }
  }

  inventory = {
    all = {
      vars = {
        ansible_user         = var.ssh.username
        node_network_cidr    = var.network.cidr
        kubernetes_api_vip   = var.cluster_addresses.api_vip
        metallb_address_pool = "${var.cluster_addresses.lb_pool_start}-${var.cluster_addresses.lb_pool_end}"
        ingress_lb_ip        = var.cluster_addresses.ingress_ip
      }
      children = {
        k8s_cluster = {
          children = {
            # Map keys are emitted sorted, so the first control plane - the one kubeadm
            # initialises - is always the lowest name, run after run.
            control_plane = { hosts = local.inventory_hosts["control_plane"] }
            workers       = { hosts = local.inventory_hosts["worker"] }
          }
        }
      }
    }
  }
}

resource "local_file" "ansible_inventory" {
  filename        = "${path.module}/../ansible/inventory/hosts.yml"
  file_permission = "0644"
  content         = "# Generated by Terraform from infra/terraform. Edit terraform.tfvars and re-apply instead.\n${yamlencode(local.inventory)}"
}
